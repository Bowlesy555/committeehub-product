# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings > API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, never expose to the browser.
# Used by src/app/api/admin/invite, the decisions notify route, and the
# daily cron job — all server-only code, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — sends decision and task reminder emails. Optional: leave unset
# and reminders are in-app only.
RESEND_API_KEY=
# Must be onboarding@resend.dev until you verify your own domain in Resend.
RESEND_FROM_EMAIL=onboarding@resend.dev

# A random secret you make up yourself (e.g. `openssl rand -hex 32`).
# Set the same value in Vercel's env vars — Vercel automatically sends it
# as the cron job's Authorization header, which /api/cron/decisions checks.
CRON_SECRET=make-up-a-long-random-string

# ---- Per-committee settings (all optional; read in src/lib/brand.ts) ----

# The name shown in the app. Free text: "Riverside CommitteeHub",
# "CommitteeHub Riverside", or anything else. Defaults to
# "<NEXT_PUBLIC_ORG_NAME> CommitteeHub", or just "CommitteeHub".
NEXT_PUBLIC_ORG_NAME=
NEXT_PUBLIC_APP_NAME=
# Under the phone home-screen icon; keep to about 12 characters.
NEXT_PUBLIC_APP_SHORT_NAME=

# One brand colour as RRGGBB, e.g. 1F5FA8 (no # here: an unquoted # starts a
# comment in this file). The soft, strong and dark-mode shades are
# derived from it; set the dark-mode one explicitly only if needed.
NEXT_PUBLIC_BRAND_ACCENT=
NEXT_PUBLIC_BRAND_ACCENT_DARK=

# Both printed by `scripts/generate-icons.mjs --upload`. Without them the
# app uses the plain icons in /public and shows no logo.
NEXT_PUBLIC_BRAND_ICON_BASE_URL=
NEXT_PUBLIC_BRAND_LOGO_URL=
# "true" if the logo has a solid white background and needs a white badge.
NEXT_PUBLIC_BRAND_LOGO_BADGE=

# Calendar > Import action items is on for everyone; "false" switches it
# off. It uses a standard layout until the JSON profile below matches it to
# the committee's own minutes (shape: ImportProfile in src/lib/action-items.ts).
NEXT_PUBLIC_FEATURE_MINUTES_IMPORT=
NEXT_PUBLIC_MINUTES_IMPORT_PROFILE=
# Optional, "true" to switch on: the "Email link" sign-in tab. Needs custom
# SMTP set up in Supabase Auth.
NEXT_PUBLIC_FEATURE_EMAIL_LINK=
