# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings > API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, never expose to the browser.
# Used by src/app/api/admin/invite, the decisions notify route, and the
# daily cron job — all server-only code, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — used to send decision emails (quorum-reached, deadline reminders).
# Same API key you used for Supabase Auth's custom SMTP also works here.
RESEND_API_KEY=your-resend-api-key
# Must be onboarding@resend.dev until you verify your own domain in Resend.
RESEND_FROM_EMAIL=onboarding@resend.dev

# A random secret you make up yourself (e.g. `openssl rand -hex 32`).
# Set the same value in Vercel's env vars — Vercel automatically sends it
# as the cron job's Authorization header, which /api/cron/decisions checks.
CRON_SECRET=make-up-a-long-random-string
